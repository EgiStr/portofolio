// This is your Prisma schema file for the Personal Digital Ecosystem
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   // Hashed password for credentials auth
  image         String?
  role          UserRole  @default(ADMIN)
  emailVerified DateTime?
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  posts         BlogPost[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("users")
}

enum UserRole {
  ADMIN
  EDITOR
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String   @db.Text
  longDescription  String?  @db.Text
  imageUrl         String?
  liveUrl          String?
  githubUrl        String?
  featured         Boolean  @default(false)
  displayOrder     Int      @default(0)
  status           ProjectStatus @default(DRAFT)
  clicks           Int      @default(0)
  
  // Relations
  techStack        ProjectTech[]
  authorId         String
  author           User     @relation(fields: [authorId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ProjectTech {
  id        String  @id @default(cuid())
  name      String
  icon      String? // Icon name or URL
  
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_techs")
}

// ============================================
// BLOG POSTS
// ============================================

model BlogPost {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  excerpt      String?  @db.Text
  content      String   @db.Text // MDX content
  coverImage   String?
  published    Boolean  @default(false)
  publishedAt  DateTime?
  readingTime  Int      @default(0) // in minutes
  
  // Relations
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  views        BlogView[]
  tags         BlogTag[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_posts")
}

model BlogTag {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  
  posts BlogPost[]

  @@map("blog_tags")
}

model BlogView {
  id        String   @id @default(cuid())
  postId    String
  visitorIp String?
  userAgent String?
  
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  viewedAt  DateTime @default(now())

  @@map("blog_views")
}

// ============================================
// SITE CONFIGURATION
// ============================================

model SiteConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  
  updatedAt DateTime @updatedAt

  @@map("site_configs")
}

// ============================================
// EXPERIENCE / WORK HISTORY
// ============================================

model Experience {
  id          String   @id @default(cuid())
  company     String
  position    String
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  location    String?
  companyUrl  String?
  companyLogo String?
  order       Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("experiences")
}

// ============================================
// SKILLS
// ============================================

model Skill {
  id       String     @id @default(cuid())
  name     String
  icon     String?
  category SkillCategory @default(OTHER)
  level    Int        @default(50) // 0-100 proficiency
  order    Int        @default(0)
  
  // Relations
  certifications CertificationSkill[]
  
  createdAt DateTime @default(now())

  @@map("skills")
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  DATABASE
  DEVOPS
  TOOL
  OTHER
}

// ============================================
// CERTIFICATIONS
// ============================================

model Certification {
  id               String   @id @default(cuid())
  name             String
  organization     String
  issueDate        DateTime
  credentialId     String?
  verificationUrl  String?
  organizationLogo String?
  certificateFile  String?  // PDF or image of the certificate
  category         CertificationCategory @default(OTHER)
  displayOrder     Int      @default(0)
  
  // Relations
  skills           CertificationSkill[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("certifications")
}

enum CertificationCategory {
  MACHINE_LEARNING
  CLOUD_COMPUTING
  DATA_ANALYTICS
  WEB_DEVELOPMENT
  MOBILE_DEVELOPMENT
  DEVOPS
  CYBERSECURITY
  DATABASE
  OTHER
}

model CertificationSkill {
  id              String        @id @default(cuid())
  certificationId String
  skillId         String
  
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([certificationId, skillId])
  @@map("certification_skills")
}

// ============================================
// EDS - STORAGE NODES
// ============================================

model StorageNode {
  id                    String    @id @default(cuid())
  email                 String    @unique // Google account email
  accessTokenEncrypted  String    @db.Text
  refreshTokenEncrypted String    @db.Text
  totalSpace            BigInt    @default(16106127360) // 15GB in bytes
  usedSpace             BigInt    @default(0)
  reservedSpace         BigInt    @default(0)
  isActive              Boolean   @default(true)
  tokenExpiresAt        DateTime?
  lastSyncAt            DateTime?
  
  // Relations
  files                 EDSFile[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("eds_storage_nodes")
}

// ============================================
// EDS - VIRTUAL FOLDERS
// ============================================

model EDSFolder {
  id        String      @id @default(cuid())
  name      String      // Display name (original user input)
  slug      String      // URL-safe name for routing
  path      String      // Full path for quick lookup: /documents/work
  parentId  String?
  parent    EDSFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  EDSFolder[] @relation("FolderHierarchy")
  files     EDSFile[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, slug])
  @@index([slug])
  @@index([path])
  @@map("eds_folders")
}

// ============================================
// EDS - FILES
// ============================================

model EDSFile {
  id           String       @id @default(cuid())
  name         String       // Display name (original file name)
  slug         String       // URL-safe file name
  mimeType     String
  size         BigInt
  sha256Hash   String?
  googleFileId String
  
  // Relations
  nodeId       String
  node         StorageNode  @relation(fields: [nodeId], references: [id])
  folderId     String?
  folder       EDSFolder?   @relation(fields: [folderId], references: [id])
  
  uploadedAt   DateTime     @default(now())
  deletedAt    DateTime?    // Soft delete

  @@unique([folderId, slug])
  @@index([slug])
  @@index([nodeId])
  @@map("eds_files")
}

// ============================================
// EDS - UPLOAD RESERVATIONS
// ============================================

model EDSReservation {
  id        String   @id @default(cuid())
  nodeId    String
  size      BigInt
  expiresAt DateTime
  
  createdAt DateTime @default(now())

  @@map("eds_reservations")
}

// ============================================
// EDS - ACTIVITY LOG
// ============================================

model EDSActivityLog {
  id         String   @id @default(cuid())
  action     String   // UPLOAD, DOWNLOAD, DELETE, NODE_ADDED, etc
  targetType String   // FILE, FOLDER, NODE
  targetId   String?
  metadata   Json?
  
  createdAt  DateTime @default(now())

  @@map("eds_activity_logs")
}

// ============================================
// EDS - API KEYS (External Access)
// ============================================

model ApiKey {
  id          String   @id @default(cuid())
  name        String   // Label: "Backup Server CLI"
  keyPrefix   String   // First 7 chars for identification (ex: "exstr_l...")
  keyHash     String   // SHA-256 hash of full key
  lastUsedAt  DateTime?
  isActive    Boolean  @default(true)
  
  // Future: userId relation for multi-tenant
  // userId      String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([keyHash])
  @@map("eds_api_keys")
}

// ============================================
// CONTACT FORM SUBMISSIONS
// ============================================

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  source    String?  // "landing", "blog", etc. — for attribution
  ipAddress String?
  userAgent String?

  // Lifecycle
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  repliedAt DateTime?
  notes     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([read, createdAt])
  @@index([email])
  @@map("contact_submissions")
}

// ============================================
// NEWSLETTER SUBSCRIBERS
// ============================================

model NewsletterSubscriber {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  // Source tracking
  source String? // "landing-footer", "blog-sidebar", "landing-inline", etc.

  // Lifecycle
  confirmedAt   DateTime?
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([confirmedAt])
  @@index([unsubscribedAt])
  @@map("newsletter_subscribers")
}

// ============================================
// CV (cv.eggisatria.my.id)
// ============================================

// One CV document. BASE is the master CV; TAILORED versions are copies adjusted
// for one job. `content` and `style` follow the zod schema in @ecosystem/cv.
// Tailoring never writes back to Experience/Project rows.
model CvVersion {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  kind           CvKind   @default(TAILORED)
  targetRole     String?
  company        String?
  jobDescription String?  @db.Text
  content        Json
  style          Json?
  atsScore       Int?
  isPublic       Boolean  @default(false)
  isPrimary      Boolean  @default(false)
  brainNotePath  String?
  createdBy      String?  // "manager", "mcp:<key name>", "seed"

  // The job application this version was tailored for (null for the master CV).
  applicationId String?
  application   JobApplication?  @relation("ApplicationVersions", fields: [applicationId], references: [id], onDelete: SetNull)
  sentFor       JobApplication[] @relation("SentCv")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPrimary])
  @@index([applicationId])
  @@map("cv_versions")
}

enum CvKind {
  BASE
  TAILORED
}

// ============================================
// Job tracker (manager /dashboard/applications)
// ============================================

// One job application: a company and role, its stage, and the CV versions
// tailored for it. Contact and salary fields stay in this database only; the
// brain note gets company, role, stage, dates, source, link, CV and ATS score.
model JobApplication {
  id             String   @id @default(cuid())
  company        String
  role           String
  location       String?
  jobUrl         String?
  source         String?  // LinkedIn, Glints, Jobstreet, referral, company site
  jobDescription String?  @db.Text
  stage          JobStage @default(WISHLIST)
  appliedAt      DateTime?
  followUpAt     DateTime?
  contactName    String?
  contactEmail   String?
  contactUrl     String?
  salaryExpected String?
  salaryOffer    String?
  notes          String?  @db.Text
  brainNotePath  String?
  createdBy      String?

  sentCvId String?
  sentCv   CvVersion?   @relation("SentCv", fields: [sentCvId], references: [id], onDelete: SetNull)
  versions CvVersion[]  @relation("ApplicationVersions")
  events   JobApplicationEvent[]
  letters   CoverLetter[]         @relation("ApplicationLetters")
  documents ApplicationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@map("job_applications")
}

// Timeline entry: a stage change, an interview or test round, a note.
model JobApplicationEvent {
  id            String    @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String    // stage | interview | assessment | note | follow_up
  stage         JobStage?
  title         String
  at            DateTime  @default(now())
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([applicationId, at])
  @@map("job_application_events")
}

enum JobStage {
  WISHLIST
  APPLIED
  SCREENING
  ASSESSMENT
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
  GHOSTED
}

// ============================================
// Cover letters and the document library (manager /dashboard/applications)
// ============================================

// A cover letter written for one application, stored like a CV version:
// structured content, a style, and a compare-and-set updatedAt. Private by
// default because it is addressed to one company.
model CoverLetter {
  id         String  @id @default(cuid())
  slug       String  @unique
  title      String
  company    String?
  targetRole String?
  content    Json
  style      Json?
  isPublic   Boolean @default(false)
  createdBy  String? // "manager", "mcp:<key name>", "seed"

  applicationId String?
  application   JobApplication? @relation("ApplicationLetters", fields: [applicationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@map("cover_letters")
}

enum DocumentKind {
  DIPLOMA
  TRANSCRIPT
  CERTIFICATE
  OTHER
}

// A fixed document (diploma, transcript) uploaded once to the private
// "documents" storage bucket and attached to any number of applications.
// Only the storage path is kept here; links are signed and expire.
model Document {
  id          String       @id @default(cuid())
  kind        DocumentKind @default(OTHER)
  title       String
  fileName    String
  storagePath String       @unique
  mimeType    String
  sizeBytes   Int

  applications ApplicationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

model ApplicationDocument {
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@id([applicationId, documentId])
  @@index([documentId])
  @@map("application_documents")
}
